# Copy to .env. Never commit .env.

# Option A: local stack from docker compose (no account needed)
SUPABASE_URL=http://localhost:3000
SUPABASE_REST_PATH=
SUPABASE_KEY=
DEBUG=true
AUTO_SEED=true

# Option B: a real Supabase project (paste schema.sql into its SQL editor first)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_REST_PATH=/rest/v1
# SUPABASE_KEY=<service-role or secret key>
# DEBUG=false

# CORS_ORIGINS=http://localhost:5173

# Email notifications (SMTP). Empty SMTP_HOST disables sending.
# Local demo uses Mailpit via docker compose (host=mailpit, port=1025).
# SMTP_HOST=smtp.gmail.com   # or smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password-or-key
# SMTP_TLS=true
# SMTP_FROM=Workload Balancer <no-reply@yourdomain>
