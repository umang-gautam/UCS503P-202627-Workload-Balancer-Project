# Copy to .env. Never commit .env.

# Option A: local stack from docker compose (no account needed)
SUPABASE_URL=http://localhost:3000
SUPABASE_REST_PATH=
SUPABASE_KEY=
DEBUG=true
AUTO_SEED=true

# Option B: a real Supabase project (paste schema.sql into its SQL editor first)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_REST_PATH=/rest/v1
# SUPABASE_KEY=<service-role or secret key>
# DEBUG=false

# CORS_ORIGINS=http://localhost:5173

# Email reminders via Web3Forms (https://web3forms.com). Empty key = sending
# disabled (no-op). Web3Forms delivers to the inbox the key is registered to.
# WEB3FORMS_KEY=your-access-key
# MAIL_FROM_NAME=Workload Balancer
